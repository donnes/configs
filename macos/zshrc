# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH
export PATH="$HOME/.local/bin:$PATH"

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Theme
ZSH_THEME="robbyrussell"

# Plugins
plugins=(git)

source $ZSH/oh-my-zsh.sh

# User configuration

# Aliases
alias cdc="z ~/.donnes/configs"
alias lg="lazygit"
alias t='tmux attach || tmux new -s Work'
alias nv="nvim"
# Explicit agent profiles. Claude aliases use the current Claude login.
alias cc="claude --dangerously-skip-permissions"
alias cc-levers="claude --dangerously-skip-permissions --mcp-config ~/.mcp-profiles/levers.json --strict-mcp-config"
alias cc-purpose="claude --dangerously-skip-permissions --mcp-config ~/.mcp-profiles/purpose.json --strict-mcp-config"
alias codex-levers="CODEX_HOME=~/.codex-levers codex --dangerously-bypass-approvals-and-sandbox"
alias codex-purpose="CODEX_HOME=~/.codex-purpose codex --dangerously-bypass-approvals-and-sandbox"
# Separate MCP auth/config/state; AI-provider auth.json remains shared.
# Project OpenCode config is disabled to keep these explicit MCP profiles separate.
alias oc-levers='env -u OPENCODE_CONFIG -u OPENCODE_CONFIG_CONTENT OPENCODE_CONFIG_DIR="$HOME/.config/opencode-levers" XDG_CONFIG_HOME="$HOME/.local/share/opencode-profiles/levers/config" XDG_DATA_HOME="$HOME/.local/share/opencode-profiles/levers/data" XDG_STATE_HOME="$HOME/.local/share/opencode-profiles/levers/state" OPENCODE_DISABLE_PROJECT_CONFIG=true opencode' 
alias oc-purpose='env -u OPENCODE_CONFIG -u OPENCODE_CONFIG_CONTENT OPENCODE_CONFIG_DIR="$HOME/.config/opencode-purpose" XDG_CONFIG_HOME="$HOME/.local/share/opencode-profiles/purpose/config" XDG_DATA_HOME="$HOME/.local/share/opencode-profiles/purpose/data" XDG_STATE_HOME="$HOME/.local/share/opencode-profiles/purpose/state" OPENCODE_DISABLE_PROJECT_CONFIG=true opencode'

# Language
export LANG=en_US.UTF-8

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
export PATH="$PATH:$HOME/.bun/bin"

# Python
export PATH="$HOME/Library/Python/3.9/bin:$PATH"

# Atuin
export ATUIN_INSTALL="$HOME/.atuin"
export PATH="$ATUIN_INSTALL/bin:$PATH"
eval "$(atuin init zsh)"

# Android SDK & Java SDK
export ANDROID_SDK_ROOT="$HOME/Library/Android/sdk"
export PATH="${PATH}:$HOME/Library/Android/sdk/platform-tools"
export JAVA_HOME=/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home

# Node
export NODE_OPTIONS=--max-old-space-size=4096

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# Windsurf
export PATH="$HOME/.codeium/windsurf/bin:$PATH"
export EDITOR="c --wait"

# bob
export PATH="/Users/$USER/.local/share/bob/nvim-bin/:$PATH"

export PATH="/opt/homebrew/opt/postgresql@18/bin:$PATH"

# Added by px0 installer
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Opt out of anonymous telemetry (px0 and other tools honor this)
export DO_NOT_TRACK=1

# mise manages language runtimes and agent CLIs, switching versions per project.
# Keep this last: tools prepended after activation would otherwise shadow
# mise's versions.
eval "$(mise activate zsh)"

# Zoxide comes from mise, so initialize it after activation.
eval "$(zoxide init zsh)"

# Interactive-only conveniences. Agent shells (Claude Code, Codex, T3) load this
# file without a TTY; aliasing cd/ls/grep there changes command semantics and
# output formats their scripts rely on, so only enable them for a real terminal.
if [[ -t 1 ]]; then
  alias cd='z'
  alias ls="eza --color=auto --long --git --no-filesize --icons=always --no-time --no-user --no-permissions"
else
  unalias grep 2>/dev/null  # oh-my-zsh adds --exclude-dir flags
fi

# Vite+ (https://viteplus.dev), after mise so its own vp comes first. Its node,
# npm, pnpm, yarn and bun shims run in system-first mode (./cli --only mise),
# which hands them on to mise's.
[ -f "$HOME/.vite-plus/env" ] && . "$HOME/.vite-plus/env"
