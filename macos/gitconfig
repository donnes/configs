[pull]
	rebase = true
[push]
	autoSetupRemote = true
	default = current
[alias]
	undo = reset --soft HEAD^
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
  clean = git-lfs clean -- %f

# Status caching for large repos and many parallel agents. `maintenance.auto`
# keeps the commit-graph and packs fresh. Repos registered for scheduled
# maintenance (`git maintenance register`) stay in the local ~/.gitconfig.
[core]
	untrackedCache = true
# fsmonitor starts a daemon per worktree on first `git status`, so it is limited
# to project checkouts. Globally, every repo git touches got one, including tool
# caches like uv's. Linked worktrees match through their gitdir under ~/Git.
[includeIf "gitdir:~/Git/"]
	path = gitconfig-fsmonitor
[feature]
	manyFiles = true
[maintenance]
	auto = true
