# Personal additions layered after Omarchy's bash setup.
alias lg="lazygit"
alias nv="nvim"
alias cc="claude --dangerously-skip-permissions"

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)/shared/shell/git-aliases.bash"

unalias t 2>/dev/null
t() {
  cd "$HOME/Work" || return 1
  tmux attach || tmux new -s Work
}

cdc() {
  local configs_root
  configs_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
  z "$configs_root"
}

export NODE_OPTIONS=--max-old-space-size=4096

if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init bash)"
fi
