# Changes require a restart to take effect.

# Android builds (Godot's export, Gradle, React Native) use JDK 17 and the SDK the
# apps component installs. `java` on PATH stays the system default JDK.
export JAVA_HOME=/usr/lib/jvm/java-17-openjdk
export ANDROID_HOME="$HOME/Android/Sdk"
# avdmanager otherwise writes AVDs under $XDG_CONFIG_HOME/.android while the
# emulator reads ~/.android, so neither finds the other's.
export ANDROID_USER_HOME="$HOME/.android"
# T3 Code's device hub boots emulators headless with -gpu auto, which falls back
# to software Vulkan that games can't present on. The later flag wins, so the
# emulator renders on the real GPU.
export EXPO_DEVICE_HUB_EMULATOR_EXTRA_ARGS="-gpu host"
for dir in platform-tools emulator; do
  case ":$PATH:" in
    *":$ANDROID_HOME/$dir:"*) ;;
    *) export PATH="$PATH:$ANDROID_HOME/$dir" ;;
  esac
done
