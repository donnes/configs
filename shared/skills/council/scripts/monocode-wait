#!/usr/bin/env python3
"""monocode-wait: block until Monocode sessions go idle.

Usage: monocode-wait CLI SESSION_ID...

CLI is the Monocode executable from your Operator context. Prints one line per
session as it settles. Exits 0 when all are idle, 1 on a CLI error, 2 on bad
input and 3 at the time limit, when you should run it again.

sessions.start returns before busy is guaranteed to be set, so one idle reading
proves nothing. A session counts as idle after several in a row. Idle does not
mean the session succeeded: read its reply, and treat no reply as a failure.
"""
import json
import subprocess
import sys
import time

POLL_SECONDS = 15
IDLE_READINGS = 3
# Stays under the 10 minute limit on a foreground command in Claude Code.
TIME_LIMIT_SECONDS = 540


def busy(cli, session):
    payload = json.dumps({"sessionId": session, "limit": 1, "maxChars": 200})
    run = subprocess.run(
        [cli, "app", "sessions.read", "--json", payload],
        capture_output=True,
        text=True,
    )
    try:
        reply = json.loads(run.stdout)
    except json.JSONDecodeError:
        raise RuntimeError((run.stderr or run.stdout).strip() or f"exit {run.returncode}")
    if not reply.get("ok"):
        raise RuntimeError(str(reply.get("error", reply)))
    return bool(reply["result"]["busy"])


def main(args):
    if len(args) < 2 or not all(arg.isdigit() for arg in args[1:]):
        print(__doc__, file=sys.stderr)
        return 2
    cli, sessions = args[0], [int(arg) for arg in args[1:]]
    idle = dict.fromkeys(sessions, 0)
    deadline = time.monotonic() + TIME_LIMIT_SECONDS
    while True:
        for session in [s for s, count in idle.items() if count < IDLE_READINGS]:
            try:
                idle[session] = 0 if busy(cli, session) else idle[session] + 1
            except (OSError, RuntimeError) as error:
                print(f"{session} error: {error}", file=sys.stderr)
                return 1
            if idle[session] == IDLE_READINGS:
                print(f"{session} idle", flush=True)
        waiting = [str(s) for s, count in idle.items() if count < IDLE_READINGS]
        if not waiting:
            return 0
        if time.monotonic() >= deadline:
            print(f"still busy: {' '.join(waiting)}", flush=True)
            return 3
        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
