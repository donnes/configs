# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_personal
  IdentitiesOnly yes

Host pc donnes-pc donnes-pc.* 100.110.174.118 192.168.1.21
  HostName donnes-pc.tail24bc37.ts.net
  HostKeyAlias donnes-pc
  User donnes
  IdentityFile ~/.ssh/id_ed25519_donnes-pc
  IdentitiesOnly yes
  ServerAliveInterval 30
  ServerAliveCountMax 4
