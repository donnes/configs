{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "agent": {
    "plan": {
      "model": "openai/gpt-5.2",
      "variant": "xhigh"
    },
    "build": {
      "model": "openai/gpt-5.3-codex",
      "variant": "xhigh"
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env*": "deny"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "deny"
    },
    "external_directory": "allow"
  }
}
