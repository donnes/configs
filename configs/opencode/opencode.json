{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "model": "opencode-go/kimi-k2.6",
    },
    "build": {
      "model": "opencode-go/kimi-k2.6",
    }
  },
  "permission": {
    "read": {
      "*.env*": "deny",
      "*": "allow"
    },
    "bash": {
      "cat *.env*": "deny",
      "grep *.env*": "deny",
      "rm -rf *": "deny",
      "*": "allow"
    },
    "external_directory": "allow"
  },
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    }
  }
}
