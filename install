#!/usr/bin/env bash

set -Eeuo pipefail

REPO_URL="https://github.com/donnes/configs.git"
DEFAULT_REPO="$HOME/.donnes/configs"
MARKER_LABEL="donnes/configs"

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

is_dry_run_arg() {
  local arg
  for arg in "$@"; do
    [[ "$arg" == "--dry-run" ]] && return 0
  done
  return 1
}

bootstrap() {
  if [[ -d "$DEFAULT_REPO/.git" && -x "$DEFAULT_REPO/install" ]]; then
    exec "$DEFAULT_REPO/install" "$@"
  fi

  if [[ -e "$DEFAULT_REPO" ]]; then
    die "$DEFAULT_REPO exists but is not an installable configs checkout"
  fi

  if is_dry_run_arg "$@"; then
    printf '[clone] %s -> %s\n' "$REPO_URL" "$DEFAULT_REPO"
    printf '[run]   %s/install --dry-run\n' "$DEFAULT_REPO"
    # When invoked through curl | bash, consume the rest of the script before
    # exiting so curl does not report a broken output pipe.
    if [[ -z "${BASH_SOURCE[0]:-}" ]]; then
      cat >/dev/null
    fi
    exit 0
  fi

  command -v git >/dev/null 2>&1 || die "git is required to clone $REPO_URL"
  mkdir -p "$(dirname "$DEFAULT_REPO")"
  git clone "$REPO_URL" "$DEFAULT_REPO"
  exec "$DEFAULT_REPO/install" "$@"
}

SCRIPT_PATH="${BASH_SOURCE[0]:-}"
if [[ -z "$SCRIPT_PATH" || ! -f "$SCRIPT_PATH" ]]; then
  bootstrap "$@"
fi

REPO_ROOT="$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)"
if [[ ! -d "$REPO_ROOT/shared" ]]; then
  bootstrap "$@"
fi

DRY_RUN=0
SKIP_PACKAGES=0
ACTION="install"
ADOPT_PATH=""
REMOVE_SKILLS=()
INTERACTIVE=0
SKIP_COMPONENTS=","
ONLY_COMPONENTS=","
VALID_COMPONENTS="packages agents skills atuin nvim shell tmux git session"

usage() {
  cat <<'EOF'
Usage:
  ./install --interactive
  ./install [--dry-run] [--skip COMPONENT]... [--only COMPONENT]...
  ./install [--dry-run] adopt <path>
  ./install [--dry-run] update <path>
  ./install [--dry-run] remove-skill [name...]
  ./install [--dry-run] uninstall

Options:
  --dry-run        Print every planned package, link, and block edit.
  -i, --interactive
                   Choose components in an interactive prompt.
  --skip COMPONENT Skip a component. May be repeated.
  --only COMPONENT Install or uninstall only a component. May be repeated.
  --skip-packages  Alias for --skip packages.
  --list-components
                   List selectable components and exit.
  -h, --help       Show this help.

Components:
  packages agents skills atuin nvim shell tmux git session
EOF
}

add_component() {
  local variable="$1"
  local component="$2"
  local current

  [[ " $VALID_COMPONENTS " == *" $component "* ]] ||
    die "unknown component: $component (use --list-components)"
  current="${!variable}"
  [[ "$current" == *",$component,"* ]] || printf -v "$variable" '%s%s,' "$current" "$component"
}

component_enabled() {
  local component="$1"
  [[ "$SKIP_COMPONENTS" != *",$component,"* ]] &&
    { [[ "$ONLY_COMPONENTS" == "," ]] || [[ "$ONLY_COMPONENTS" == *",$component,"* ]]; }
}

run_component() {
  local component="$1"
  shift
  if component_enabled "$component"; then
    "$@"
  else
    log_action skip "$component component disabled"
  fi
}

choose_components() {
  local component reply prompt_action

  [[ -r /dev/tty && -w /dev/tty ]] || die "interactive mode requires a terminal"
  if [[ "$ACTION" == "uninstall" ]]; then
    prompt_action="Uninstall"
  else
    prompt_action="Install"
  fi

  printf '\nChoose components for the %s profile. Press Enter to accept each default.\n\n' "$PROFILE" >/dev/tty
  for component in $VALID_COMPONENTS; do
    if [[ "$PROFILE" == "omarchy" && "$component" == "git" ]]; then
      continue
    fi
    while true; do
      printf '%s %s? [Y/n] ' "$prompt_action" "$component" >/dev/tty
      IFS= read -r reply </dev/tty || die "interactive selection cancelled"
      case "$reply" in
        "" | y | Y | yes | YES | Yes) break ;;
        n | N | no | NO | No)
          add_component SKIP_COMPONENTS "$component"
          break
          ;;
        *) printf 'Please answer y or n.\n' >/dev/tty ;;
      esac
    done
  done
  printf '\n' >/dev/tty
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      ;;
    -i | --interactive)
      INTERACTIVE=1
      ;;
    --skip-packages)
      SKIP_PACKAGES=1
      ;;
    --skip | --only)
      option="$1"
      shift
      [[ $# -gt 0 ]] || die "$option requires a component"
      [[ "$1" != --* ]] || die "$option requires a component"
      if [[ "$option" == "--skip" ]]; then
        add_component SKIP_COMPONENTS "$1"
      else
        add_component ONLY_COMPONENTS "$1"
      fi
      ;;
    --list-components)
      printf '%s\n' $VALID_COMPONENTS
      exit 0
      ;;
    install)
      ACTION="install"
      ;;
    uninstall)
      ACTION="uninstall"
      ;;
    adopt)
      ACTION="adopt"
      ;;
    update)
      ACTION="update"
      ;;
    remove-skill)
      ACTION="remove-skill"
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --*)
      die "unknown option: $1"
      ;;
    *)
      if [[ "$ACTION" == "remove-skill" ]]; then
        REMOVE_SKILLS+=("$1")
      elif [[ ( "$ACTION" == "adopt" || "$ACTION" == "update" ) && -z "$ADOPT_PATH" ]]; then
        ADOPT_PATH="$1"
      else
        die "unexpected argument: $1"
      fi
      ;;
  esac
  shift
done

if [[ "$SKIP_PACKAGES" -eq 1 ]]; then
  add_component SKIP_COMPONENTS packages
fi

if [[ "$SKIP_COMPONENTS" != "," && "$ONLY_COMPONENTS" != "," ]]; then
  die "--skip and --only cannot be used together"
fi

if [[ "$INTERACTIVE" -eq 1 && ( "$SKIP_COMPONENTS" != "," || "$ONLY_COMPONENTS" != "," ) ]]; then
  die "--interactive cannot be combined with --skip, --only, or --skip-packages"
fi

if [[ ( "$ACTION" == "adopt" || "$ACTION" == "update" || "$ACTION" == "remove-skill" ) &&
  ( "$SKIP_COMPONENTS" != "," || "$ONLY_COMPONENTS" != "," ) ]]; then
  die "--skip and --only apply only to install and uninstall"
fi

if [[ ( "$ACTION" == "adopt" || "$ACTION" == "update" ) && -z "$ADOPT_PATH" ]]; then
  die "$ACTION requires a path"
fi

detect_profile() {
  if [[ -n "${DONNES_CONFIGS_PROFILE:-}" ]]; then
    case "$DONNES_CONFIGS_PROFILE" in
      omarchy | macos) printf '%s\n' "$DONNES_CONFIGS_PROFILE" ;;
      *) die "DONNES_CONFIGS_PROFILE must be omarchy or macos" ;;
    esac
  elif [[ -d /usr/share/omarchy ]]; then
    printf 'omarchy\n'
  elif [[ "$(uname -s)" == "Darwin" ]]; then
    printf 'macos\n'
  else
    die "unsupported system: expected Omarchy or macOS"
  fi
}

PROFILE="$(detect_profile)"

if [[ "$INTERACTIVE" -eq 1 ]]; then
  if [[ "$ACTION" == "install" || "$ACTION" == "uninstall" ]]; then
    choose_components
  elif [[ "$ACTION" != "remove-skill" ]]; then
    die "--interactive applies only to install, uninstall, and remove-skill"
  fi
fi

pretty_path() {
  local path="$1"
  case "$path" in
    "$REPO_ROOT") printf '<repo>' ;;
    "$REPO_ROOT"/*) printf '<repo>/%s' "${path#"$REPO_ROOT"/}" ;;
    "$HOME") printf '~' ;;
    "$HOME"/*) printf '~/%s' "${path#"$HOME"/}" ;;
    *) printf '%s' "$path" ;;
  esac
}

log_action() {
  local kind="$1"
  shift
  printf '[%-7s] %s\n' "$kind" "$*"
}

path_exists() {
  [[ -e "$1" || -L "$1" ]]
}

is_managed_symlink() {
  local path="$1"
  local target
  [[ -L "$path" ]] || return 1
  target="$(readlink "$path")"
  [[ "$target" == "$REPO_ROOT" ||
    "$target" == "$REPO_ROOT/"* ||
    "$target" == "$HOME/.syncode/repo" ||
    "$target" == "$HOME/.syncode/repo/"* ||
    "$target" == "~/.syncode/repo" ||
    "$target" == "~/.syncode/repo/"* ]]
}

is_legacy_syncode_symlink() {
  local path="$1"
  local target
  [[ -L "$path" ]] || return 1
  target="$(readlink "$path")"
  [[ "$target" == "$HOME/.syncode/repo" ||
    "$target" == "$HOME/.syncode/repo/"* ||
    "$target" == "~/.syncode/repo" ||
    "$target" == "~/.syncode/repo/"* ]]
}

# Canonical path of an existing file or directory, following symlinks.
real_path() {
  if command -v realpath >/dev/null 2>&1; then
    realpath "$1" 2>/dev/null
  else
    python3 -c 'import os, sys; p = os.path.realpath(sys.argv[1]); os.stat(p); print(p)' "$1" 2>/dev/null
  fi
}

content_differs() {
  ! diff -rq -x .DS_Store "$1" "$2" >/dev/null 2>&1
}

# Modification times (epoch seconds) of a file or every file in a directory.
file_mtimes() {
  local format=(-c '%Y')
  stat -c '%Y' / >/dev/null 2>&1 || format=(-f '%m')
  find -L "$1" -type f ! -name .DS_Store -exec stat "${format[@]}" {} + 2>/dev/null
}

latest_mtime() {
  file_mtimes "$1" | sort -n | tail -n 1
}

format_mtime() {
  [[ -n "$1" ]] || { printf 'unknown'; return 0; }
  date -r "$1" '+%Y-%m-%d %H:%M' 2>/dev/null || date -d "@$1" '+%Y-%m-%d %H:%M'
}

# Real paths of local copies the user chose to keep during this run, so a link
# that leads to one (such as ~/.claude/skills/x -> ~/.agents/skills/x) is kept too.
KEPT_PATHS=$'\n'

can_prompt() {
  [[ -t 1 && -r /dev/tty && -w /dev/tty ]]
}

# Replace whatever is at dest with a link to src. Only call once the content at
# dest is identical to src, or the user chose to replace or update it.
replace_with_link() {
  local src="$1"
  local dest="$2"

  if [[ -L "$dest" || -f "$dest" ]]; then
    rm -f "$dest"
  elif [[ -d "$dest" ]]; then
    rm -rf "$dest"
  fi
  mkdir -p "$(dirname "$dest")"
  ln -sfn "$src" "$dest"
}

copy_into_repo() {
  local current="$1"
  local src="$2"

  if [[ -d "$current" ]]; then
    rm -rf "$src"
    cp -pR "$current" "$src"
    find "$src" -name .DS_Store -delete
  else
    cp -p "$current" "$src"
  fi
}

# dest holds content that differs from src. Nothing is ever backed up: the user
# keeps the local copy, replaces it with the repo version, or copies it into the
# repo. The most recently modified side is the default answer.
resolve_conflict() {
  local src="$1"
  local dest="$2"
  local current="$3"
  local local_time repo_time newer default reply can_update=0
  local choices

  [[ "$src" == "$REPO_ROOT/"* ]] && can_update=1
  local_time="$(latest_mtime "$current")"
  repo_time="$(latest_mtime "$src")"
  newer="same age"
  default="k"
  if [[ -n "$local_time" && -n "$repo_time" ]]; then
    if [[ "$local_time" -gt "$repo_time" ]]; then
      newer="local is newer"
      [[ "$can_update" -eq 1 ]] && default="u"
    elif [[ "$repo_time" -gt "$local_time" ]]; then
      newer="repo is newer"
      default="r"
    fi
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    log_action differs "$(pretty_path "$dest") differs from $(pretty_path "$src") ($newer); would ask"
    return 0
  fi
  if ! can_prompt; then
    log_action keep "$(pretty_path "$dest") differs from $(pretty_path "$src") ($newer); rerun in a terminal to choose"
    KEPT_PATHS="$KEPT_PATHS$current"$'\n'
    return 0
  fi

  printf '\n%s differs from %s\n' "$(pretty_path "$dest")" "$(pretty_path "$src")" >/dev/tty
  printf '  local modified %s, repo modified %s (%s)\n' \
    "$(format_mtime "$local_time")" "$(format_mtime "$repo_time")" "$newer" >/dev/tty
  if [[ -d "$current" ]]; then
    diff -rq -x .DS_Store "$src" "$current" 2>/dev/null |
      sed -e "s|$src|repo|g" -e "s|$current|local|g" -e 's/^/  /' >/dev/tty || true
  fi
  choices='[k]eep local, [r]eplace with repo'
  [[ "$can_update" -eq 1 ]] && choices="$choices, [u]pdate repo from local"
  while true; do
    printf '%s, [d]iff? [%s] ' "$choices" "$default" >/dev/tty
    IFS= read -r reply </dev/tty || reply="k"
    [[ -n "$reply" ]] || reply="$default"
    case "$reply" in
      k | K)
        log_action keep "$(pretty_path "$dest") local copy"
        KEPT_PATHS="$KEPT_PATHS$current"$'\n'
        return 0
        ;;
      r | R)
        log_action replace "$(pretty_path "$dest") -> $(pretty_path "$src")"
        replace_with_link "$src" "$dest"
        return 0
        ;;
      u | U)
        if [[ "$can_update" -eq 1 ]]; then
          log_action update "$(pretty_path "$dest") -> $(pretty_path "$src")"
          copy_into_repo "$current" "$src"
          replace_with_link "$src" "$dest"
          return 0
        fi
        printf 'The source is outside the repo and cannot be updated.\n' >/dev/tty
        ;;
      d | D)
        diff -ru -x .DS_Store "$src" "$current" >/dev/tty 2>&1 || true
        ;;
      *) printf 'Please choose one of the listed letters.\n' >/dev/tty ;;
    esac
  done
}

link_file() {
  local src="$1"
  local dest="$2"
  local assume_missing="${3:-0}"
  local current=""

  if [[ "$assume_missing" -eq 1 ]] || ! path_exists "$dest"; then
    log_action link "$(pretty_path "$dest") -> $(pretty_path "$src")"
    if [[ "$DRY_RUN" -eq 0 ]]; then
      mkdir -p "$(dirname "$dest")"
      ln -sfn "$src" "$dest"
    fi
    return 0
  fi

  if [[ -L "$dest" && "$(readlink "$dest")" == "$src" ]]; then
    log_action skip "$(pretty_path "$dest") already links to $(pretty_path "$src")"
    return 0
  fi

  if ! is_managed_symlink "$dest"; then
    current="$(real_path "$dest")" || current=""
  fi
  if [[ -n "$current" && "$current" != "$(real_path "$src")" ]] && content_differs "$src" "$current"; then
    if [[ "$KEPT_PATHS" == *$'\n'"$current"$'\n'* ]]; then
      log_action keep "$(pretty_path "$dest") local copy"
    else
      resolve_conflict "$src" "$dest" "$current"
    fi
    return 0
  fi

  # Managed, dangling, identical, or already resolving to src.
  log_action relink "$(pretty_path "$dest") -> $(pretty_path "$src")"
  [[ "$DRY_RUN" -eq 1 ]] || replace_with_link "$src" "$dest"
}

link_tree() {
  local src="$1"
  local dest="$2"
  local assume_missing="${3:-0}"
  local skip_relative="${4:-}"
  local file relative

  [[ -d "$src" ]] || return 0
  while IFS= read -r -d '' file; do
    relative="${file#"$src"/}"
    [[ -n "$skip_relative" && "$relative" == "$skip_relative" ]] && continue
    link_file "$file" "$dest/$relative" "$assume_missing"
  done < <(find "$src" \( -type f -o -type l \) -print0)
}

# Codex skips symlinked SKILL.md files but follows symlinked directories, so
# each skill is linked as one directory instead of file by file.
link_skill_dir() {
  link_file "$@"
}

link_skills() {
  local src="$1"
  local dest="$2"
  local entry

  [[ -d "$src" ]] || return 0
  for entry in "$src"/*; do
    path_exists "$entry" || continue
    if [[ -d "$entry" ]]; then
      link_skill_dir "$entry" "$dest/$(basename "$entry")"
    else
      link_file "$entry" "$dest/$(basename "$entry")"
    fi
  done
}

# Remove dangling skill links left behind when a skill is deleted from the repo.
# Only links into the repo or ~/.agents/skills are touched.
prune_skill_links() {
  local dest="$1"
  local entry target target_dir

  [[ -d "$dest" ]] || return 0
  for entry in "$dest"/*; do
    [[ -L "$entry" && ! -e "$entry" ]] || continue
    target="$(readlink "$entry")"
    [[ "$target" == /* ]] || target="$(dirname "$entry")/$target"
    target_dir="$(cd "$(dirname "$target")" 2>/dev/null && pwd)" || target_dir=""
    if is_managed_symlink "$entry" || [[ "$target_dir" == "$HOME/.agents/skills" ]]; then
      log_action prune "$(pretty_path "$entry") (target missing)"
      [[ "$DRY_RUN" -eq 1 ]] || unlink "$entry"
    fi
  done
}

file_mode() {
  stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1"
}

# Optional third argument: the target file's comment prefix (default "#").
append_block() {
  local file="$1"
  local content="$2"
  local comment="${3:-#}"
  local marker_start="$comment >>> $MARKER_LABEL >>>"
  local marker_end="$comment <<< $MARKER_LABEL <<<"
  local operation="add"
  local tmp mode

  if [[ -f "$file" ]] && grep -Fq -e "$marker_start" "$file"; then
    operation="replace"
  fi
  log_action append "$operation managed block in $(pretty_path "$file")"
  [[ "$DRY_RUN" -eq 1 ]] && return 0

  mkdir -p "$(dirname "$file")"
  [[ -e "$file" ]] || : >"$file"
  tmp="$file.donnes-configs.$$"
  mode="$(file_mode "$file")"

  awk -v start="$marker_start" -v end="$marker_end" '
    $0 == start { skipping = 1; next }
    skipping && $0 == end { skipping = 0; next }
    !skipping { lines[++count] = $0 }
    END {
      while (count > 0 && lines[count] == "") count--
      for (i = 1; i <= count; i++) print lines[i]
    }
  ' "$file" >"$tmp"

  if [[ -s "$tmp" ]]; then
    printf '\n' >>"$tmp"
  fi
  printf '%s\n%s\n%s\n' "$marker_start" "$content" "$marker_end" >>"$tmp"
  chmod "$mode" "$tmp"
  mv "$tmp" "$file"
}

remove_block() {
  local file="$1"
  local comment="${2:-#}"
  local marker_start="$comment >>> $MARKER_LABEL >>>"
  local marker_end="$comment <<< $MARKER_LABEL <<<"
  local tmp mode

  [[ -f "$file" ]] || return 0
  grep -Fq -e "$marker_start" "$file" || return 0
  log_action remove "managed block from $(pretty_path "$file")"
  [[ "$DRY_RUN" -eq 1 ]] && return 0

  tmp="$file.donnes-configs.$$"
  mode="$(file_mode "$file")"
  awk -v start="$marker_start" -v end="$marker_end" '
    $0 == start { skipping = 1; next }
    skipping && $0 == end { skipping = 0; next }
    !skipping { print }
  ' "$file" >"$tmp"
  chmod "$mode" "$tmp"
  mv "$tmp" "$file"
}

skill_lock_path() {
  if [[ -n "${XDG_STATE_HOME:-}" ]]; then
    printf '%s/skills/.skill-lock.json\n' "$XDG_STATE_HOME"
  else
    printf '%s/.agents/.skill-lock.json\n' "$HOME"
  fi
}

sync_skills_lock() {
  local repo_lock="$REPO_ROOT/shared/skills.lock.json"
  local local_lock
  local_lock="$(skill_lock_path)"

  if [[ -L "$local_lock" && "$(readlink "$local_lock")" == "$repo_lock" ]]; then
    log_action skip "$(pretty_path "$local_lock") already links to $(pretty_path "$repo_lock")"
    return 0
  fi
  if path_exists "$local_lock"; then
    [[ -f "$local_lock" ]] || die "$local_lock is not a readable lockfile"
    command -v python3 >/dev/null 2>&1 || die "python3 is required to merge skills lockfiles"
    log_action sync "merge $(pretty_path "$local_lock") into $(pretty_path "$repo_lock") (local values win)"
    if [[ "$DRY_RUN" -eq 1 ]]; then
      python3 "$REPO_ROOT/scripts/merge-skills-lock.py" "$repo_lock" "$local_lock" --dry-run
    else
      python3 "$REPO_ROOT/scripts/merge-skills-lock.py" "$repo_lock" "$local_lock"
    fi
    log_action relink "$(pretty_path "$local_lock") -> $(pretty_path "$repo_lock")"
    [[ "$DRY_RUN" -eq 1 ]] || replace_with_link "$repo_lock" "$local_lock"
  else
    link_file "$repo_lock" "$local_lock"
  fi
}

install_packages() {
  local brew_bin

  if [[ "$SKIP_PACKAGES" -eq 1 ]]; then
    log_action skip "package installation disabled"
    return 0
  fi

  if [[ "$PROFILE" == "omarchy" ]]; then
    command -v yay >/dev/null 2>&1 || die "yay is required on Omarchy"
    log_action package "yay -S --needed - < $(pretty_path "$REPO_ROOT/packages/omarchy.txt")"
    if [[ "$DRY_RUN" -eq 0 ]]; then
      yay -S --needed - <"$REPO_ROOT/packages/omarchy.txt"
    fi
    return 0
  fi

  brew_bin="$(command -v brew 2>/dev/null || true)"
  if [[ -z "$brew_bin" ]]; then
    if [[ "$DRY_RUN" -eq 1 ]]; then
      log_action package "install Homebrew"
      brew_bin="brew"
    else
      NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      if [[ -x /opt/homebrew/bin/brew ]]; then
        brew_bin="/opt/homebrew/bin/brew"
      elif [[ -x /usr/local/bin/brew ]]; then
        brew_bin="/usr/local/bin/brew"
      else
        die "Homebrew installed but brew was not found"
      fi
    fi
  fi

  log_action package "$brew_bin install < $(pretty_path "$REPO_ROOT/packages/macos.txt")"
  log_action package "$brew_bin trust --tap abue-ammar/tinycast"
  log_action package "$brew_bin install --cask < $(pretty_path "$REPO_ROOT/packages/macos-casks.txt")"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    xargs "$brew_bin" install <"$REPO_ROOT/packages/macos.txt"
    "$brew_bin" trust --tap abue-ammar/tinycast
    xargs "$brew_bin" install --cask <"$REPO_ROOT/packages/macos-casks.txt"
  fi
}

install_nvim() {
  local dest="$HOME/.config/nvim"
  local managed_init="$dest/init.lua"
  local assume_empty=0

  if [[ -L "$managed_init" && "$(readlink "$managed_init")" == "$REPO_ROOT/shared/nvim/init.lua" ]]; then
    assume_empty=0
  elif is_legacy_syncode_symlink "$dest"; then
    log_action relink "$(pretty_path "$dest") legacy syncode tree -> per-file links"
    if [[ "$DRY_RUN" -eq 0 ]]; then
      unlink "$dest"
    fi
    assume_empty=1
  elif [[ -L "$dest" ]]; then
    # A foreign link to a whole config directory; drop the link, not its target.
    log_action unlink "$(pretty_path "$dest") -> $(readlink "$dest")"
    [[ "$DRY_RUN" -eq 1 ]] || unlink "$dest"
    assume_empty=1
  elif path_exists "$dest"; then
    # Existing files are compared one by one; untracked ones stay in place.
    assume_empty=0
  else
    assume_empty=1
  fi

  if [[ "$PROFILE" == "omarchy" ]]; then
    link_tree "$REPO_ROOT/shared/nvim" "$dest" "$assume_empty" "lua/plugins/theme.lua"
    link_tree "$REPO_ROOT/omarchy/nvim" "$dest" "$assume_empty"
    link_file "$HOME/.local/state/omarchy/current/theme/neovim.lua" "$dest/lua/plugins/theme.lua" "$assume_empty"
  else
    link_tree "$REPO_ROOT/shared/nvim" "$dest" "$assume_empty"
    if [[ -d "$REPO_ROOT/macos/nvim" ]]; then
      link_tree "$REPO_ROOT/macos/nvim" "$dest"
    fi
  fi
}

install_agents() {
  local source="$REPO_ROOT/shared/agents/global/AGENTS.md"
  link_file "$source" "${CODEX_HOME:-$HOME/.codex}/AGENTS.md"
  link_file "$source" "$HOME/.claude/CLAUDE.md"
}

uninstall_agents() {
  local source="$REPO_ROOT/shared/agents/global/AGENTS.md"
  unlink_file "$source" "${CODEX_HOME:-$HOME/.codex}/AGENTS.md"
  unlink_file "$source" "$HOME/.claude/CLAUDE.md"
}

install_shared() {
  run_component agents install_agents
  if component_enabled skills; then
    # ~/.claude/skills can link through ~/.agents/skills, so prune that first.
    prune_skill_links "$HOME/.agents/skills"
    prune_skill_links "$HOME/.claude/skills"
    link_skills "$REPO_ROOT/shared/skills" "$HOME/.agents/skills"
    link_skills "$REPO_ROOT/shared/skills" "$HOME/.claude/skills"
    sync_skills_lock
  else
    log_action skip "skills component disabled"
  fi
  run_component atuin link_tree "$REPO_ROOT/shared/atuin" "$HOME/.config/atuin"
  run_component nvim install_nvim

  log_action skip "shared/ghostty is excluded from the default install"
  log_action skip "shared/yazi is excluded from the default install"
  log_action skip "shared/ssh is excluded from the default install"
}

install_omarchy() {
  local tmux_config="$HOME/.config/tmux/tmux.conf"

  if component_enabled shell; then
    append_block "$HOME/.bashrc" "source \"$REPO_ROOT/omarchy/bashrc.local\""
    link_tree "$REPO_ROOT/omarchy/uwsm" "$HOME/.config/uwsm"
    link_tree "$REPO_ROOT/omarchy/bin" "$HOME/.local/bin"
  else
    log_action skip "shell component disabled"
  fi
  run_component session install_session
  if component_enabled tmux; then
    [[ -f "$tmux_config" || "$DRY_RUN" -eq 1 ]] || die "$tmux_config is missing; restore Omarchy's tmux config first"
    link_file "$REPO_ROOT/omarchy/tmux.local.conf" "$HOME/.config/tmux/local.conf"
    append_block "$tmux_config" "source-file -q ~/.config/tmux/local.conf"
  else
    log_action skip "tmux component disabled"
  fi
}

SESSION_TIMER="hypr-session-autosave.timer"

# Hyprland session save/restore: hypr-session (linked by the shell component),
# its autosave timer, and hypr/session.lua required from hyprland.lua.
install_session() {
  local hyprland_config="$HOME/.config/hypr/hyprland.lua"

  [[ -f "$hyprland_config" || "$DRY_RUN" -eq 1 ]] || die "$hyprland_config is missing; restore Omarchy's Hyprland config first"
  link_tree "$REPO_ROOT/omarchy/hypr" "$HOME/.config/hypr"
  link_tree "$REPO_ROOT/omarchy/systemd/user" "$HOME/.config/systemd/user"
  append_block "$hyprland_config" 'require("hypr.session")' "--"
  log_action enable "systemd user timer $SESSION_TIMER"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    systemctl --user daemon-reload
    systemctl --user enable --now "$SESSION_TIMER"
  fi
}

uninstall_session() {
  log_action disable "systemd user timer $SESSION_TIMER"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    systemctl --user disable --now "$SESSION_TIMER" 2>/dev/null || true
  fi
  remove_block "$HOME/.config/hypr/hyprland.lua" "--"
  unlink_tree "$REPO_ROOT/omarchy/hypr" "$HOME/.config/hypr"
  unlink_tree "$REPO_ROOT/omarchy/systemd/user" "$HOME/.config/systemd/user"
  [[ "$DRY_RUN" -eq 1 ]] || systemctl --user daemon-reload
}

install_macos() {
  run_component shell link_file "$REPO_ROOT/macos/zshrc" "$HOME/.zshrc"
  run_component shell append_block "$HOME/.zshenv" "source \"$REPO_ROOT/macos/zshenv\""
  run_component shell link_tree "$REPO_ROOT/macos/bin" "$HOME/.local/bin"
  run_component git link_file "$REPO_ROOT/macos/gitconfig" "$HOME/.gitconfig"
  run_component tmux link_file "$REPO_ROOT/macos/tmux.conf" "$HOME/.tmux.conf"
}

unlink_file() {
  local src="$1"
  local dest="$2"

  if [[ -L "$dest" && "$(readlink "$dest")" == "$src" ]]; then
    log_action unlink "$(pretty_path "$dest")"
    if [[ "$DRY_RUN" -eq 0 ]]; then
      unlink "$dest"
    fi
  fi
}

unlink_tree() {
  local src="$1"
  local dest="$2"
  local file relative

  [[ -d "$src" ]] || return 0
  while IFS= read -r -d '' file; do
    relative="${file#"$src"/}"
    unlink_file "$file" "$dest/$relative"
  done < <(find "$src" \( -type f -o -type l \) -print0)
}

unlink_skills() {
  local src="$1"
  local dest="$2"
  local entry

  [[ -d "$src" ]] || return 0
  for entry in "$src"/*; do
    unlink_file "$entry" "$dest/$(basename "$entry")"
  done
}

uninstall_shared() {
  run_component agents uninstall_agents
  if component_enabled skills; then
    unlink_tree "$REPO_ROOT/shared/skills" "$HOME/.agents/skills"
    unlink_skills "$REPO_ROOT/shared/skills" "$HOME/.agents/skills"
    unlink_skills "$REPO_ROOT/shared/skills" "$HOME/.claude/skills"
    unlink_file "$REPO_ROOT/shared/skills.lock.json" "$(skill_lock_path)"
  else
    log_action skip "skills component disabled"
  fi
  run_component atuin unlink_tree "$REPO_ROOT/shared/atuin" "$HOME/.config/atuin"
  run_component nvim unlink_tree "$REPO_ROOT/shared/nvim" "$HOME/.config/nvim"
}

uninstall_profile() {
  if [[ "$PROFILE" == "omarchy" ]]; then
    run_component session uninstall_session
    run_component shell remove_block "$HOME/.bashrc"
    run_component shell unlink_tree "$REPO_ROOT/omarchy/uwsm" "$HOME/.config/uwsm"
    run_component shell unlink_tree "$REPO_ROOT/omarchy/bin" "$HOME/.local/bin"
    if component_enabled tmux; then
      remove_block "$HOME/.config/tmux/tmux.conf"
      unlink_file "$REPO_ROOT/omarchy/tmux.local.conf" "$HOME/.config/tmux/local.conf"
    else
      log_action skip "tmux component disabled"
    fi
    run_component nvim unlink_tree "$REPO_ROOT/omarchy/nvim" "$HOME/.config/nvim"
  else
    run_component shell unlink_file "$REPO_ROOT/macos/zshrc" "$HOME/.zshrc"
    run_component shell remove_block "$HOME/.zshenv"
    run_component shell unlink_tree "$REPO_ROOT/macos/bin" "$HOME/.local/bin"
    run_component git unlink_file "$REPO_ROOT/macos/gitconfig" "$HOME/.gitconfig"
    run_component tmux unlink_file "$REPO_ROOT/macos/tmux.conf" "$HOME/.tmux.conf"
    if component_enabled nvim && [[ -d "$REPO_ROOT/macos/nvim" ]]; then
      unlink_tree "$REPO_ROOT/macos/nvim" "$HOME/.config/nvim"
    fi
  fi
}

MAP_REPO_ROOT=""
MAP_DEST_ROOT=""

map_directory() {
  local path="$1"
  local dest_root="$2"
  local repo_root="$3"
  if [[ "$path" == "$dest_root" || "$path" == "$dest_root/"* ]]; then
    MAP_DEST_ROOT="$dest_root"
    MAP_REPO_ROOT="$repo_root"
    return 0
  fi
  return 1
}

resolve_adopt_map() {
  local path="$1"
  local ghostty_dest

  MAP_REPO_ROOT=""
  MAP_DEST_ROOT=""

  if [[ "$PROFILE" == "macos" ]]; then
    ghostty_dest="$HOME/Library/Application Support/com.mitchellh.ghostty"
  else
    ghostty_dest="$HOME/.config/ghostty"
  fi

  map_directory "$path" "$HOME/.agents/skills" "$REPO_ROOT/shared/skills" && return 0
  map_directory "$path" "$HOME/.config/nvim" "$REPO_ROOT/shared/nvim" && return 0
  map_directory "$path" "$HOME/.config/atuin" "$REPO_ROOT/shared/atuin" && return 0
  map_directory "$path" "$ghostty_dest" "$REPO_ROOT/shared/ghostty" && return 0
  map_directory "$path" "$HOME/.config/yazi" "$REPO_ROOT/shared/yazi" && return 0
  map_directory "$path" "$HOME/.ssh" "$REPO_ROOT/shared/ssh" && return 0
  map_directory "$path" "$HOME/.local/bin" "$REPO_ROOT/$PROFILE/bin" && return 0
  if [[ "$PROFILE" == "omarchy" ]]; then
    map_directory "$path" "$HOME/.config/hypr" "$REPO_ROOT/omarchy/hypr" && return 0
    map_directory "$path" "$HOME/.config/systemd/user" "$REPO_ROOT/omarchy/systemd/user" && return 0
  fi
  return 1
}

absolute_existing_path() {
  local input="$1"
  local parent base

  case "$input" in
    "~/"*) input="$HOME/${input#\~/}" ;;
  esac
  if [[ "$input" != /* ]]; then
    input="$PWD/$input"
  fi
  parent="$(cd "$(dirname "$input")" && pwd -P)" || return 1
  base="$(basename "$input")"
  printf '%s/%s\n' "$parent" "$base"
}

is_skill_dir() {
  [[ -d "$1" && "$(dirname "$1")" == "$REPO_ROOT/shared/skills" ]]
}

adopt_path() {
  local source repo_target relative file file_relative

  source="$(absolute_existing_path "$ADOPT_PATH")" || die "cannot resolve $ADOPT_PATH"
  path_exists "$source" || die "$source does not exist"
  [[ ! -L "$source" ]] || die "$source is already a symlink"
  resolve_adopt_map "$source" || die "$source is outside the managed path map"

  if [[ "$source" == "$MAP_DEST_ROOT" ]]; then
    die "adopt a file or child directory, not the managed root itself"
  fi

  relative="${source#"$MAP_DEST_ROOT"/}"
  repo_target="$MAP_REPO_ROOT/$relative"
  path_exists "$repo_target" && die "$(pretty_path "$repo_target") already exists"

  log_action adopt "$(pretty_path "$source") -> $(pretty_path "$repo_target")"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    if [[ -d "$source" && "$(dirname "$repo_target")" != "$REPO_ROOT/shared/skills" ]]; then
      while IFS= read -r -d '' file; do
        file_relative="${file#"$source"/}"
        log_action link "$(pretty_path "$source/$file_relative") -> $(pretty_path "$repo_target/$file_relative")"
      done < <(find "$source" \( -type f -o -type l \) -print0)
    else
      log_action link "$(pretty_path "$source") -> $(pretty_path "$repo_target")"
    fi
    return 0
  fi

  mkdir -p "$(dirname "$repo_target")"
  mv "$source" "$repo_target"
  if is_skill_dir "$repo_target"; then
    link_skill_dir "$repo_target" "$source" 1
  elif [[ -d "$repo_target" ]]; then
    link_tree "$repo_target" "$source" 1
  else
    link_file "$repo_target" "$source" 1
  fi
}

update_path() {
  local source repo_target relative file file_relative target

  source="$(absolute_existing_path "$ADOPT_PATH")" || die "cannot resolve $ADOPT_PATH"
  path_exists "$source" || die "$source does not exist"
  if [[ "$source" == "$(skill_lock_path)" ]]; then
    sync_skills_lock
    return 0
  fi
  [[ ! -L "$source" ]] || die "$source is already a symlink; edits already write through to its target"

  if [[ "$source" == "$HOME/.config/nvim/lazy-lock.json" ]]; then
    repo_target="$REPO_ROOT/$PROFILE/nvim/lazy-lock.json"
  else
    resolve_adopt_map "$source" || die "$source is outside the managed path map"
    if [[ "$source" == "$MAP_DEST_ROOT" ]]; then
      die "update a file or child directory, not the managed root itself"
    fi
    relative="${source#"$MAP_DEST_ROOT"/}"
    repo_target="$MAP_REPO_ROOT/$relative"
  fi

  path_exists "$repo_target" || die "$(pretty_path "$repo_target") does not exist; use adopt instead"

  if [[ -d "$source" ]]; then
    [[ -d "$repo_target" ]] || die "$(pretty_path "$repo_target") is not a directory"
    while IFS= read -r -d '' file; do
      file_relative="${file#"$source"/}"
      target="$repo_target/$file_relative"
      if [[ ! -f "$target" ]] || ! cmp -s "$file" "$target"; then
        log_action update "$(pretty_path "$file") -> $(pretty_path "$target")"
      fi
      if [[ "$DRY_RUN" -eq 0 ]]; then
        mkdir -p "$(dirname "$target")"
        cp "$file" "$target"
      fi
      if [[ "$DRY_RUN" -eq 1 ]] && ! is_skill_dir "$repo_target"; then
        log_action link "$(pretty_path "$file") -> $(pretty_path "$target")"
      fi
    done < <(find "$source" -type f -print0)

    if is_skill_dir "$repo_target"; then
      link_skill_dir "$repo_target" "$source"
    elif [[ "$DRY_RUN" -eq 0 ]]; then
      link_tree "$repo_target" "$source"
    fi
  else
    [[ -f "$repo_target" ]] || die "$(pretty_path "$repo_target") is not a file"
    if ! cmp -s "$source" "$repo_target"; then
      log_action update "$(pretty_path "$source") -> $(pretty_path "$repo_target")"
    fi
    if [[ "$DRY_RUN" -eq 0 ]]; then
      cp "$source" "$repo_target"
      link_file "$repo_target" "$source"
    else
      log_action link "$(pretty_path "$source") -> $(pretty_path "$repo_target")"
    fi
  fi
}

case "$ACTION" in
  install)
    printf 'Profile: %s\nRepo:    %s\n\n' "$PROFILE" "$REPO_ROOT"
    run_component packages install_packages
    install_shared
    if [[ "$PROFILE" == "omarchy" ]]; then
      install_omarchy
    else
      install_macos
    fi
    ;;
  uninstall)
    printf 'Profile: %s\nRepo:    %s\n\n' "$PROFILE" "$REPO_ROOT"
    uninstall_profile
    uninstall_shared
    log_action note "packages were left untouched"
    ;;
  adopt)
    adopt_path
    ;;
  update)
    update_path
    ;;
  remove-skill)
    command -v python3 >/dev/null 2>&1 || die "python3 is required to remove skills"
    # Bash 3.2 with nounset cannot expand an empty array.
    if [[ ${#REMOVE_SKILLS[@]} -eq 0 ]]; then
      if [[ "$DRY_RUN" -eq 1 ]]; then
        python3 "$REPO_ROOT/scripts/remove-skills.py" "$REPO_ROOT" --dry-run
      else
        python3 "$REPO_ROOT/scripts/remove-skills.py" "$REPO_ROOT"
      fi
      exit
    fi
    if [[ "$DRY_RUN" -eq 1 ]]; then
      python3 "$REPO_ROOT/scripts/remove-skills.py" "$REPO_ROOT" --dry-run "${REMOVE_SKILLS[@]}"
    else
      python3 "$REPO_ROOT/scripts/remove-skills.py" "$REPO_ROOT" "${REMOVE_SKILLS[@]}"
    fi
    ;;
esac
