#!/usr/bin/env bash

set -Eeuo pipefail

REPO_URL="https://github.com/donnes/configs.git"
DEFAULT_REPO="$HOME/.donnes/configs"
MARKER_START="# >>> donnes/configs >>>"
MARKER_END="# <<< donnes/configs <<<"

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

is_dry_run_arg() {
  local arg
  for arg in "$@"; do
    [[ "$arg" == "--dry-run" ]] && return 0
  done
  return 1
}

bootstrap() {
  if [[ -d "$DEFAULT_REPO/.git" && -x "$DEFAULT_REPO/install" ]]; then
    exec "$DEFAULT_REPO/install" "$@"
  fi

  if [[ -e "$DEFAULT_REPO" ]]; then
    die "$DEFAULT_REPO exists but is not an installable configs checkout"
  fi

  if is_dry_run_arg "$@"; then
    printf '[clone] %s -> %s\n' "$REPO_URL" "$DEFAULT_REPO"
    printf '[run]   %s/install --dry-run\n' "$DEFAULT_REPO"
    # When invoked through curl | bash, consume the rest of the script before
    # exiting so curl does not report a broken output pipe.
    if [[ -z "${BASH_SOURCE[0]:-}" ]]; then
      cat >/dev/null
    fi
    exit 0
  fi

  command -v git >/dev/null 2>&1 || die "git is required to clone $REPO_URL"
  mkdir -p "$(dirname "$DEFAULT_REPO")"
  git clone "$REPO_URL" "$DEFAULT_REPO"
  exec "$DEFAULT_REPO/install" "$@"
}

SCRIPT_PATH="${BASH_SOURCE[0]:-}"
if [[ -z "$SCRIPT_PATH" || ! -f "$SCRIPT_PATH" ]]; then
  bootstrap "$@"
fi

REPO_ROOT="$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)"
if [[ ! -d "$REPO_ROOT/shared" ]]; then
  bootstrap "$@"
fi

DRY_RUN=0
SKIP_PACKAGES=0
ACTION="install"
ADOPT_PATH=""
INTERACTIVE=0
SKIP_COMPONENTS=","
ONLY_COMPONENTS=","
VALID_COMPONENTS="packages skills claude codex atuin nvim shell tmux git"

usage() {
  cat <<'EOF'
Usage:
  ./install --interactive
  ./install [--dry-run] [--skip COMPONENT]... [--only COMPONENT]...
  ./install [--dry-run] adopt <path>
  ./install [--dry-run] update <path>
  ./install [--dry-run] uninstall

Options:
  --dry-run        Print every planned package, backup, link, and block edit.
  -i, --interactive
                   Choose components in an interactive prompt.
  --skip COMPONENT Skip a component. May be repeated.
  --only COMPONENT Install or uninstall only a component. May be repeated.
  --skip-packages  Alias for --skip packages.
  --list-components
                   List selectable components and exit.
  -h, --help       Show this help.

Components:
  packages skills claude codex atuin nvim shell tmux git
EOF
}

add_component() {
  local variable="$1"
  local component="$2"
  local current

  [[ " $VALID_COMPONENTS " == *" $component "* ]] ||
    die "unknown component: $component (use --list-components)"
  current="${!variable}"
  [[ "$current" == *",$component,"* ]] || printf -v "$variable" '%s%s,' "$current" "$component"
}

component_enabled() {
  local component="$1"
  [[ "$SKIP_COMPONENTS" != *",$component,"* ]] &&
    { [[ "$ONLY_COMPONENTS" == "," ]] || [[ "$ONLY_COMPONENTS" == *",$component,"* ]]; }
}

run_component() {
  local component="$1"
  shift
  if component_enabled "$component"; then
    "$@"
  else
    log_action skip "$component component disabled"
  fi
}

choose_components() {
  local component reply prompt_action

  [[ -r /dev/tty && -w /dev/tty ]] || die "interactive mode requires a terminal"
  if [[ "$ACTION" == "uninstall" ]]; then
    prompt_action="Uninstall"
  else
    prompt_action="Install"
  fi

  printf '\nChoose components for the %s profile. Press Enter to accept each default.\n\n' "$PROFILE" >/dev/tty
  for component in $VALID_COMPONENTS; do
    if [[ "$PROFILE" == "omarchy" && "$component" == "git" ]]; then
      continue
    fi
    while true; do
      printf '%s %s? [Y/n] ' "$prompt_action" "$component" >/dev/tty
      IFS= read -r reply </dev/tty || die "interactive selection cancelled"
      case "$reply" in
        "" | y | Y | yes | YES | Yes) break ;;
        n | N | no | NO | No)
          add_component SKIP_COMPONENTS "$component"
          break
          ;;
        *) printf 'Please answer y or n.\n' >/dev/tty ;;
      esac
    done
  done
  printf '\n' >/dev/tty
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      ;;
    -i | --interactive)
      INTERACTIVE=1
      ;;
    --skip-packages)
      SKIP_PACKAGES=1
      ;;
    --skip | --only)
      option="$1"
      shift
      [[ $# -gt 0 ]] || die "$option requires a component"
      [[ "$1" != --* ]] || die "$option requires a component"
      if [[ "$option" == "--skip" ]]; then
        add_component SKIP_COMPONENTS "$1"
      else
        add_component ONLY_COMPONENTS "$1"
      fi
      ;;
    --list-components)
      printf '%s\n' $VALID_COMPONENTS
      exit 0
      ;;
    install)
      ACTION="install"
      ;;
    uninstall)
      ACTION="uninstall"
      ;;
    adopt)
      ACTION="adopt"
      ;;
    update)
      ACTION="update"
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --*)
      die "unknown option: $1"
      ;;
    *)
      if [[ ( "$ACTION" == "adopt" || "$ACTION" == "update" ) && -z "$ADOPT_PATH" ]]; then
        ADOPT_PATH="$1"
      else
        die "unexpected argument: $1"
      fi
      ;;
  esac
  shift
done

if [[ "$SKIP_PACKAGES" -eq 1 ]]; then
  add_component SKIP_COMPONENTS packages
fi

if [[ "$SKIP_COMPONENTS" != "," && "$ONLY_COMPONENTS" != "," ]]; then
  die "--skip and --only cannot be used together"
fi

if [[ "$INTERACTIVE" -eq 1 && ( "$SKIP_COMPONENTS" != "," || "$ONLY_COMPONENTS" != "," ) ]]; then
  die "--interactive cannot be combined with --skip, --only, or --skip-packages"
fi

if [[ ( "$ACTION" == "adopt" || "$ACTION" == "update" ) &&
  ( "$SKIP_COMPONENTS" != "," || "$ONLY_COMPONENTS" != "," ) ]]; then
  die "--skip and --only apply only to install and uninstall"
fi

if [[ ( "$ACTION" == "adopt" || "$ACTION" == "update" ) && -z "$ADOPT_PATH" ]]; then
  die "$ACTION requires a path"
fi

detect_profile() {
  if [[ -n "${DONNES_CONFIGS_PROFILE:-}" ]]; then
    case "$DONNES_CONFIGS_PROFILE" in
      omarchy | macos) printf '%s\n' "$DONNES_CONFIGS_PROFILE" ;;
      *) die "DONNES_CONFIGS_PROFILE must be omarchy or macos" ;;
    esac
  elif [[ -d /usr/share/omarchy ]]; then
    printf 'omarchy\n'
  elif [[ "$(uname -s)" == "Darwin" ]]; then
    printf 'macos\n'
  else
    die "unsupported system: expected Omarchy or macOS"
  fi
}

PROFILE="$(detect_profile)"

if [[ "$INTERACTIVE" -eq 1 ]]; then
  [[ "$ACTION" == "install" || "$ACTION" == "uninstall" ]] ||
    die "--interactive applies only to install and uninstall"
  choose_components
fi

pretty_path() {
  local path="$1"
  case "$path" in
    "$REPO_ROOT") printf '<repo>' ;;
    "$REPO_ROOT"/*) printf '<repo>/%s' "${path#"$REPO_ROOT"/}" ;;
    "$HOME") printf '~' ;;
    "$HOME"/*) printf '~/%s' "${path#"$HOME"/}" ;;
    *) printf '%s' "$path" ;;
  esac
}

log_action() {
  local kind="$1"
  shift
  printf '[%-7s] %s\n' "$kind" "$*"
}

path_exists() {
  [[ -e "$1" || -L "$1" ]]
}

is_managed_symlink() {
  local path="$1"
  local target
  [[ -L "$path" ]] || return 1
  target="$(readlink "$path")"
  [[ "$target" == "$REPO_ROOT" ||
    "$target" == "$REPO_ROOT/"* ||
    "$target" == "$HOME/.syncode/repo" ||
    "$target" == "$HOME/.syncode/repo/"* ||
    "$target" == "~/.syncode/repo" ||
    "$target" == "~/.syncode/repo/"* ]]
}

is_legacy_syncode_symlink() {
  local path="$1"
  local target
  [[ -L "$path" ]] || return 1
  target="$(readlink "$path")"
  [[ "$target" == "$HOME/.syncode/repo" ||
    "$target" == "$HOME/.syncode/repo/"* ||
    "$target" == "~/.syncode/repo" ||
    "$target" == "~/.syncode/repo/"* ]]
}

backup_once() {
  local path="$1"
  local timestamp backup suffix

  path_exists "$path" || return 0
  timestamp="$(date '+%Y%m%d-%H%M%S')"
  backup="$path.backup.$timestamp"
  suffix=1
  while path_exists "$backup"; do
    backup="$path.backup.$timestamp.$suffix"
    suffix=$((suffix + 1))
  done

  log_action backup "$(pretty_path "$path") -> $(pretty_path "$backup")"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    mv "$path" "$backup"
  fi
}

link_file() {
  local src="$1"
  local dest="$2"
  local assume_missing="${3:-0}"
  local current=""

  if [[ "$assume_missing" -eq 0 && -L "$dest" ]]; then
    current="$(readlink "$dest")"
    if [[ "$current" == "$src" ]]; then
      log_action skip "$(pretty_path "$dest") already links to $(pretty_path "$src")"
      return 0
    fi
  fi

  if [[ "$assume_missing" -eq 0 ]] && path_exists "$dest"; then
    if is_managed_symlink "$dest"; then
      log_action relink "$(pretty_path "$dest") -> $(pretty_path "$src")"
    elif [[ -f "$src" && -f "$dest" ]] && cmp -s "$src" "$dest"; then
      log_action relink "$(pretty_path "$dest") identical content -> $(pretty_path "$src")"
    else
      backup_once "$dest"
    fi
  else
    log_action link "$(pretty_path "$dest") -> $(pretty_path "$src")"
  fi

  if [[ "$DRY_RUN" -eq 0 ]]; then
    mkdir -p "$(dirname "$dest")"
    ln -sfn "$src" "$dest"
  fi
}

link_tree() {
  local src="$1"
  local dest="$2"
  local assume_missing="${3:-0}"
  local skip_relative="${4:-}"
  local file relative

  [[ -d "$src" ]] || return 0
  while IFS= read -r -d '' file; do
    relative="${file#"$src"/}"
    [[ -n "$skip_relative" && "$relative" == "$skip_relative" ]] && continue
    link_file "$file" "$dest/$relative" "$assume_missing"
  done < <(find "$src" \( -type f -o -type l \) -print0)
}

file_mode() {
  stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1"
}

append_block() {
  local file="$1"
  local content="$2"
  local operation="add"
  local tmp mode

  if [[ -f "$file" ]] && grep -Fq "$MARKER_START" "$file"; then
    operation="replace"
  fi
  log_action append "$operation managed block in $(pretty_path "$file")"
  [[ "$DRY_RUN" -eq 1 ]] && return 0

  mkdir -p "$(dirname "$file")"
  [[ -e "$file" ]] || : >"$file"
  tmp="$file.donnes-configs.$$"
  mode="$(file_mode "$file")"

  awk -v start="$MARKER_START" -v end="$MARKER_END" '
    $0 == start { skipping = 1; next }
    skipping && $0 == end { skipping = 0; next }
    !skipping { lines[++count] = $0 }
    END {
      while (count > 0 && lines[count] == "") count--
      for (i = 1; i <= count; i++) print lines[i]
    }
  ' "$file" >"$tmp"

  if [[ -s "$tmp" ]]; then
    printf '\n' >>"$tmp"
  fi
  printf '%s\n%s\n%s\n' "$MARKER_START" "$content" "$MARKER_END" >>"$tmp"
  chmod "$mode" "$tmp"
  mv "$tmp" "$file"
}

remove_block() {
  local file="$1"
  local tmp mode

  [[ -f "$file" ]] || return 0
  grep -Fq "$MARKER_START" "$file" || return 0
  log_action remove "managed block from $(pretty_path "$file")"
  [[ "$DRY_RUN" -eq 1 ]] && return 0

  tmp="$file.donnes-configs.$$"
  mode="$(file_mode "$file")"
  awk -v start="$MARKER_START" -v end="$MARKER_END" '
    $0 == start { skipping = 1; next }
    skipping && $0 == end { skipping = 0; next }
    !skipping { print }
  ' "$file" >"$tmp"
  chmod "$mode" "$tmp"
  mv "$tmp" "$file"
}

skill_lock_path() {
  if [[ -n "${XDG_STATE_HOME:-}" ]]; then
    printf '%s/skills/.skill-lock.json\n' "$XDG_STATE_HOME"
  else
    printf '%s/.agents/.skill-lock.json\n' "$HOME"
  fi
}

install_packages() {
  local brew_bin

  if [[ "$SKIP_PACKAGES" -eq 1 ]]; then
    log_action skip "package installation disabled"
    return 0
  fi

  if [[ "$PROFILE" == "omarchy" ]]; then
    command -v yay >/dev/null 2>&1 || die "yay is required on Omarchy"
    log_action package "yay -S --needed - < $(pretty_path "$REPO_ROOT/packages/omarchy.txt")"
    if [[ "$DRY_RUN" -eq 0 ]]; then
      yay -S --needed - <"$REPO_ROOT/packages/omarchy.txt"
    fi
    return 0
  fi

  brew_bin="$(command -v brew 2>/dev/null || true)"
  if [[ -z "$brew_bin" ]]; then
    if [[ "$DRY_RUN" -eq 1 ]]; then
      log_action package "install Homebrew"
      brew_bin="brew"
    else
      NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      if [[ -x /opt/homebrew/bin/brew ]]; then
        brew_bin="/opt/homebrew/bin/brew"
      elif [[ -x /usr/local/bin/brew ]]; then
        brew_bin="/usr/local/bin/brew"
      else
        die "Homebrew installed but brew was not found"
      fi
    fi
  fi

  log_action package "$brew_bin install < $(pretty_path "$REPO_ROOT/packages/macos.txt")"
  log_action package "$brew_bin trust --tap abue-ammar/tinycast"
  log_action package "$brew_bin install --cask < $(pretty_path "$REPO_ROOT/packages/macos-casks.txt")"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    xargs "$brew_bin" install <"$REPO_ROOT/packages/macos.txt"
    "$brew_bin" trust --tap abue-ammar/tinycast
    xargs "$brew_bin" install --cask <"$REPO_ROOT/packages/macos-casks.txt"
  fi
}

install_nvim() {
  local dest="$HOME/.config/nvim"
  local managed_init="$dest/init.lua"
  local assume_empty=0

  if [[ -L "$managed_init" && "$(readlink "$managed_init")" == "$REPO_ROOT/shared/nvim/init.lua" ]]; then
    assume_empty=0
  elif is_legacy_syncode_symlink "$dest"; then
    log_action relink "$(pretty_path "$dest") legacy syncode tree -> per-file links"
    if [[ "$DRY_RUN" -eq 0 ]]; then
      unlink "$dest"
    fi
    assume_empty=1
  elif path_exists "$dest"; then
    backup_once "$dest"
    assume_empty=1
  else
    assume_empty=1
  fi

  if [[ "$PROFILE" == "omarchy" ]]; then
    link_tree "$REPO_ROOT/shared/nvim" "$dest" "$assume_empty" "lua/plugins/theme.lua"
    link_tree "$REPO_ROOT/omarchy/nvim" "$dest" "$assume_empty"
    link_file "$HOME/.local/state/omarchy/current/theme/neovim.lua" "$dest/lua/plugins/theme.lua" "$assume_empty"
  else
    link_tree "$REPO_ROOT/shared/nvim" "$dest" "$assume_empty"
    if [[ -d "$REPO_ROOT/macos/nvim" ]]; then
      link_tree "$REPO_ROOT/macos/nvim" "$dest"
    fi
  fi
}

install_shared() {
  if component_enabled skills; then
    link_tree "$REPO_ROOT/shared/skills" "$HOME/.agents/skills"
    link_file "$REPO_ROOT/shared/skills.lock.json" "$(skill_lock_path)"
  else
    log_action skip "skills component disabled"
  fi
  run_component claude link_tree "$REPO_ROOT/shared/claude" "$HOME/.claude"
  run_component codex link_tree "$REPO_ROOT/shared/codex" "$HOME/.codex"
  run_component atuin link_tree "$REPO_ROOT/shared/atuin" "$HOME/.config/atuin"
  run_component nvim install_nvim

  log_action skip "shared/ghostty is excluded from the default install"
  log_action skip "shared/yazi is excluded from the default install"
  log_action skip "shared/ssh is excluded from the default install"
}

install_omarchy() {
  local tmux_config="$HOME/.config/tmux/tmux.conf"

  if component_enabled shell; then
    append_block "$HOME/.bashrc" "source \"$REPO_ROOT/omarchy/bashrc.local\""
  else
    log_action skip "shell component disabled"
  fi
  if component_enabled tmux; then
    [[ -f "$tmux_config" || "$DRY_RUN" -eq 1 ]] || die "$tmux_config is missing; restore Omarchy's tmux config first"
    link_file "$REPO_ROOT/omarchy/tmux.local.conf" "$HOME/.config/tmux/local.conf"
    append_block "$tmux_config" "source-file -q ~/.config/tmux/local.conf"
  else
    log_action skip "tmux component disabled"
  fi
}

install_macos() {
  run_component shell link_file "$REPO_ROOT/macos/zshrc" "$HOME/.zshrc"
  run_component git link_file "$REPO_ROOT/macos/gitconfig" "$HOME/.gitconfig"
  run_component tmux link_file "$REPO_ROOT/macos/tmux.conf" "$HOME/.tmux.conf"
}

unlink_file() {
  local src="$1"
  local dest="$2"

  if [[ -L "$dest" && "$(readlink "$dest")" == "$src" ]]; then
    log_action unlink "$(pretty_path "$dest")"
    if [[ "$DRY_RUN" -eq 0 ]]; then
      unlink "$dest"
    fi
  fi
}

unlink_tree() {
  local src="$1"
  local dest="$2"
  local file relative

  [[ -d "$src" ]] || return 0
  while IFS= read -r -d '' file; do
    relative="${file#"$src"/}"
    unlink_file "$file" "$dest/$relative"
  done < <(find "$src" \( -type f -o -type l \) -print0)
}

uninstall_shared() {
  if component_enabled skills; then
    unlink_tree "$REPO_ROOT/shared/skills" "$HOME/.agents/skills"
    unlink_file "$REPO_ROOT/shared/skills.lock.json" "$(skill_lock_path)"
  else
    log_action skip "skills component disabled"
  fi
  run_component claude unlink_tree "$REPO_ROOT/shared/claude" "$HOME/.claude"
  run_component codex unlink_tree "$REPO_ROOT/shared/codex" "$HOME/.codex"
  run_component atuin unlink_tree "$REPO_ROOT/shared/atuin" "$HOME/.config/atuin"
  run_component nvim unlink_tree "$REPO_ROOT/shared/nvim" "$HOME/.config/nvim"
}

uninstall_profile() {
  if [[ "$PROFILE" == "omarchy" ]]; then
    run_component shell remove_block "$HOME/.bashrc"
    if component_enabled tmux; then
      remove_block "$HOME/.config/tmux/tmux.conf"
      unlink_file "$REPO_ROOT/omarchy/tmux.local.conf" "$HOME/.config/tmux/local.conf"
    else
      log_action skip "tmux component disabled"
    fi
    run_component nvim unlink_tree "$REPO_ROOT/omarchy/nvim" "$HOME/.config/nvim"
  else
    run_component shell unlink_file "$REPO_ROOT/macos/zshrc" "$HOME/.zshrc"
    run_component git unlink_file "$REPO_ROOT/macos/gitconfig" "$HOME/.gitconfig"
    run_component tmux unlink_file "$REPO_ROOT/macos/tmux.conf" "$HOME/.tmux.conf"
    if component_enabled nvim && [[ -d "$REPO_ROOT/macos/nvim" ]]; then
      unlink_tree "$REPO_ROOT/macos/nvim" "$HOME/.config/nvim"
    fi
  fi
}

MAP_REPO_ROOT=""
MAP_DEST_ROOT=""

map_directory() {
  local path="$1"
  local dest_root="$2"
  local repo_root="$3"
  if [[ "$path" == "$dest_root" || "$path" == "$dest_root/"* ]]; then
    MAP_DEST_ROOT="$dest_root"
    MAP_REPO_ROOT="$repo_root"
    return 0
  fi
  return 1
}

resolve_adopt_map() {
  local path="$1"
  local ghostty_dest

  MAP_REPO_ROOT=""
  MAP_DEST_ROOT=""

  if [[ "$PROFILE" == "macos" ]]; then
    ghostty_dest="$HOME/Library/Application Support/com.mitchellh.ghostty"
  else
    ghostty_dest="$HOME/.config/ghostty"
  fi

  map_directory "$path" "$HOME/.agents/skills" "$REPO_ROOT/shared/skills" && return 0
  map_directory "$path" "$HOME/.claude" "$REPO_ROOT/shared/claude" && return 0
  map_directory "$path" "$HOME/.codex" "$REPO_ROOT/shared/codex" && return 0
  map_directory "$path" "$HOME/.config/nvim" "$REPO_ROOT/shared/nvim" && return 0
  map_directory "$path" "$HOME/.config/atuin" "$REPO_ROOT/shared/atuin" && return 0
  map_directory "$path" "$ghostty_dest" "$REPO_ROOT/shared/ghostty" && return 0
  map_directory "$path" "$HOME/.config/yazi" "$REPO_ROOT/shared/yazi" && return 0
  map_directory "$path" "$HOME/.ssh" "$REPO_ROOT/shared/ssh" && return 0
  return 1
}

absolute_existing_path() {
  local input="$1"
  local parent base

  case "$input" in
    "~/"*) input="$HOME/${input#\~/}" ;;
  esac
  if [[ "$input" != /* ]]; then
    input="$PWD/$input"
  fi
  parent="$(cd "$(dirname "$input")" && pwd -P)" || return 1
  base="$(basename "$input")"
  printf '%s/%s\n' "$parent" "$base"
}

adopt_path() {
  local source repo_target relative file file_relative

  source="$(absolute_existing_path "$ADOPT_PATH")" || die "cannot resolve $ADOPT_PATH"
  path_exists "$source" || die "$source does not exist"
  [[ ! -L "$source" ]] || die "$source is already a symlink"
  resolve_adopt_map "$source" || die "$source is outside the managed path map"

  if [[ "$source" == "$MAP_DEST_ROOT" ]]; then
    die "adopt a file or child directory, not the managed root itself"
  fi

  relative="${source#"$MAP_DEST_ROOT"/}"
  repo_target="$MAP_REPO_ROOT/$relative"
  path_exists "$repo_target" && die "$(pretty_path "$repo_target") already exists"

  log_action adopt "$(pretty_path "$source") -> $(pretty_path "$repo_target")"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    if [[ -d "$source" ]]; then
      while IFS= read -r -d '' file; do
        file_relative="${file#"$source"/}"
        log_action link "$(pretty_path "$source/$file_relative") -> $(pretty_path "$repo_target/$file_relative")"
      done < <(find "$source" \( -type f -o -type l \) -print0)
    else
      log_action link "$(pretty_path "$source") -> $(pretty_path "$repo_target")"
    fi
    return 0
  fi

  mkdir -p "$(dirname "$repo_target")"
  mv "$source" "$repo_target"
  if [[ -d "$repo_target" ]]; then
    link_tree "$repo_target" "$source" 1
  else
    link_file "$repo_target" "$source" 1
  fi
}

update_path() {
  local source repo_target relative file file_relative target

  source="$(absolute_existing_path "$ADOPT_PATH")" || die "cannot resolve $ADOPT_PATH"
  path_exists "$source" || die "$source does not exist"
  [[ ! -L "$source" ]] || die "$source is already a symlink; edits already write through to its target"

  if [[ "$source" == "$(skill_lock_path)" ]]; then
    repo_target="$REPO_ROOT/shared/skills.lock.json"
  else
    resolve_adopt_map "$source" || die "$source is outside the managed path map"
    if [[ "$source" == "$MAP_DEST_ROOT" ]]; then
      die "update a file or child directory, not the managed root itself"
    fi
    relative="${source#"$MAP_DEST_ROOT"/}"
    repo_target="$MAP_REPO_ROOT/$relative"
  fi

  path_exists "$repo_target" || die "$(pretty_path "$repo_target") does not exist; use adopt instead"

  if [[ -d "$source" ]]; then
    [[ -d "$repo_target" ]] || die "$(pretty_path "$repo_target") is not a directory"
    while IFS= read -r -d '' file; do
      file_relative="${file#"$source"/}"
      target="$repo_target/$file_relative"
      if [[ ! -f "$target" ]] || ! cmp -s "$file" "$target"; then
        log_action update "$(pretty_path "$file") -> $(pretty_path "$target")"
      fi
      if [[ "$DRY_RUN" -eq 0 ]]; then
        mkdir -p "$(dirname "$target")"
        cp "$file" "$target"
      fi
      if [[ "$DRY_RUN" -eq 1 ]]; then
        log_action link "$(pretty_path "$file") -> $(pretty_path "$target")"
      fi
    done < <(find "$source" -type f -print0)

    if [[ "$DRY_RUN" -eq 0 ]]; then
      link_tree "$repo_target" "$source"
    fi
  else
    [[ -f "$repo_target" ]] || die "$(pretty_path "$repo_target") is not a file"
    if ! cmp -s "$source" "$repo_target"; then
      log_action update "$(pretty_path "$source") -> $(pretty_path "$repo_target")"
    fi
    if [[ "$DRY_RUN" -eq 0 ]]; then
      cp "$source" "$repo_target"
      link_file "$repo_target" "$source"
    else
      log_action link "$(pretty_path "$source") -> $(pretty_path "$repo_target")"
    fi
  fi
}

case "$ACTION" in
  install)
    printf 'Profile: %s\nRepo:    %s\n\n' "$PROFILE" "$REPO_ROOT"
    run_component packages install_packages
    install_shared
    if [[ "$PROFILE" == "omarchy" ]]; then
      install_omarchy
    else
      install_macos
    fi
    ;;
  uninstall)
    printf 'Profile: %s\nRepo:    %s\n\n' "$PROFILE" "$REPO_ROOT"
    uninstall_profile
    uninstall_shared
    log_action note "packages and backups were left untouched"
    ;;
  adopt)
    adopt_path
    ;;
  update)
    update_path
    ;;
esac
